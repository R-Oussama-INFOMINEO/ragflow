# ── Stellantis RagFlow Pipeline — Environment Configuration ──────────────────
# Copy this file to docker/.env and adjust values for your environment.
# Never commit docker/.env to Git.

# Document engine — use infinity for local dev, elasticsearch for production
DOC_ENGINE=${DOC_ENGINE:-elasticsearch}

# Custom Stellantis Docker image (required — built from Dockerfile.custom)
RAGFLOW_IMAGE=ragflow-stellantis:v0.24.0

# Embedding service profile:
# Local CPU dev  : COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-cpu
# Staging / GCP  : COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-gpu
# COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-cpu

# Embedding model:
# Local CPU dev  : BAAI/bge-small-en-v1.5  (requires 1.2GB RAM)
# Staging / GCP  : Qwen/Qwen3-Embedding-0.6B (requires 25GB RAM/vRAM)
TEI_MODEL=${TEI_MODEL:-Qwen/Qwen3-Embedding-0.6B}

# Timezone — set to your local timezone for development
TZ=Asia/Shanghai
